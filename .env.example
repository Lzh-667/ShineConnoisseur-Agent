# ===== LLM (DeepSeek) =====
# DEEPSEEK_API_KEY=请填写你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONER_MODEL=deepseek-v4-flash

# ===== Embedding (SiliconFlow BGE-M3) =====
# SILICONFLOW_API_KEY=请填写你的硅基流动密钥
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ===== 中间件（与后端一致）=====
MYSQL_HOST=192.168.100.129
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=shineconnoisseur

REDIS_HOST=192.168.100.129
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0

ES_URL=http://192.168.100.129:9200

# ===== 后端 REST API（写操作）=====
BACKEND_URL=http://localhost:8080

# ===== Agent 服务 =====
AGENT_HOST=0.0.0.0
AGENT_PORT=8001
AGENT_CHECKPOINT=sqlite
# 聊天限流：每分钟次数
CHAT_RATE_LIMIT=10
