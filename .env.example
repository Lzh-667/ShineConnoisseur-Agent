# ===== LLM (DeepSeek) =====
# DEEPSEEK_API_KEY=请填写你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONER_MODEL=deepseek-v4-flash
# 计费（元/百万 token，按 DeepSeek 官网当前价格填写，用于成本估算）
DEEPSEEK_INPUT_PRICE=2
DEEPSEEK_OUTPUT_PRICE=8

# ===== Embedding (SiliconFlow BGE-M3) =====
# SILICONFLOW_API_KEY=请填写你的硅基流动密钥
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ===== 中间件（与后端一致）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# MYSQL_USER=请填写数据库用户名
# MYSQL_PASSWORD=请填写数据库密码
MYSQL_DATABASE=shineconnoisseur

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=请填写Redis密码
REDIS_DB=0

ES_URL=http://127.0.0.1:9200

# ===== 后端 REST API（写操作）=====
BACKEND_URL=http://localhost:8080

# ===== Agent 服务 =====
AGENT_HOST=0.0.0.0
AGENT_PORT=8001
AGENT_CHECKPOINT=sqlite
# 聊天限流：每分钟次数
CHAT_RATE_LIMIT=10
# HTTPS 部署时开启，确保游客会话 cookie 只通过 HTTPS 传输
AGENT_COOKIE_SECURE=false
# 仅在本地受控调试环境开启直接工具调用接口
ADMIN_TOOL_INVOKE_ENABLED=false
